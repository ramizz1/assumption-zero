# ─────────────────────────────────────────────────────────────────
# Assumption Zero — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
DEBUG=false

# ── AI Provider ───────────────────────────────────────────────────
# AI_PROVIDER=beta (Default: Assumption Zero Beta AI / OpenRouter)
AI_PROVIDER=beta

# ── OpenRouter Configuration ──────────────────────────────────────
# Assumption Zero uses OpenRouter (https://openrouter.ai/keys) under the hood.
# A built-in key is provided for zero-config testing.
#
# Get your own free OpenRouter key at https://openrouter.ai/keys for higher limits:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# ── Research Providers ────────────────────────────────────────────
# GitHub: optional personal access token for higher GitHub search limits.
GITHUB_TOKEN=

# ── Timeouts ──────────────────────────────────────────────────────
REQUEST_TIMEOUT=30
