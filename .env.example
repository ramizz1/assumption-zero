# ─────────────────────────────────────────────────────────────────
# Assumption Zero — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# The app works out of the box with no configuration.
# "Assumption Zero Beta AI" is pre-configured and ready to use.
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
DEBUG=false
DATABASE_URL=sqlite:///./assumption_zero.db

# ── AI Provider ───────────────────────────────────────────────────
# Options: beta | mock | ollama
# - beta   → Assumption Zero Beta AI (built-in, no key needed) ← DEFAULT
# - mock   → Heuristic scoring only, no LLM, fully offline
# - ollama → Self-hosted local model via Ollama
AI_PROVIDER=beta

# ── Assumption Zero Beta AI / OpenRouter ──────────────────────────
# The built-in Beta AI uses OpenRouter (openrouter.ai) under the hood.
# A community key is built in — you don't need to set anything here.
#
# To use your own OpenRouter key (for higher rate limits or private models):
#   OPENROUTER_API_KEY=sk-or-v1-your-key-here
#
# To choose a different model (default: meta-llama/llama-3.3-70b-instruct:free):
#   OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
#   OPENROUTER_MODEL=google/gemma-3-27b-it:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Ollama (local, self-hosted models) ────────────────────────────
# Install Ollama from https://ollama.ai and run: ollama pull llama3.2
# Then set: AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Research Providers ────────────────────────────────────────────
# SearXNG: set your self-hosted instance URL, or leave blank to skip.
# See https://docs.searxng.org/admin/installation.html
SEARXNG_BASE_URL=

# GitHub: optional personal-access token for higher rate limits.
# Without a token the unauthenticated limit (60 req/hr) applies.
GITHUB_TOKEN=

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10

# ── Timeouts ──────────────────────────────────────────────────────
REQUEST_TIMEOUT=30

# ── CORS (comma-separated origins) ───────────────────────────────
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
