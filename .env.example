# ─────────────────────────────────────────────────────────────────────────────
# Assumption Zero — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
DEBUG=false
# Keep false for trusted local development with Ollama/custom localhost URLs.
# Set true on every public deployment to block local/private custom endpoints.
SSRF_PROTECTION_ENABLED=false

# JSON array of browser origins allowed to call the API directly.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── AI Provider ───────────────────────────────────────────────────
# Options: auto, groq, openrouter, hybrid, ollama, opencode, openai_compat, openai, mock
# Default: "auto" uses the first configured provider, then an evidence-based baseline.
AI_PROVIDER=auto

# ── OpenRouter Configuration ──────────────────────────────────────
# Get your own free OpenRouter key at https://openrouter.ai/keys:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# ── Groq Configuration ───────────────────────────────────────────
# Get free ultra-fast key at https://console.groq.com/keys:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── OpenCode AI Configuration ─────────────────────────────────────
# OpenCode AI API provider (https://opencode.ai)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/api/v1
OPENCODE_MODEL=opencode/claude-3.5-sonnet

# ── Local Ollama Configuration ────────────────────────────────────
# Connect to your local Ollama server (http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Custom / OpenAI-Compatible Provider ───────────────────────────
# Use this to plug in ChatGPT, Claude (proxy), DeepSeek, Together AI, Mistral,
# LM Studio (local), vLLM self-hosted, or any OpenAI-spec API.
# Set AI_PROVIDER=openai_compat to activate.
#
# Examples:
#   OpenAI ChatGPT:   BASE_URL=https://api.openai.com/v1  MODEL=gpt-4o-mini
#   DeepSeek:         BASE_URL=https://api.deepseek.com/v1  MODEL=deepseek-chat
#   Together AI:      BASE_URL=https://api.together.xyz/v1  MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#
#OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
#OPENAI_COMPATIBLE_API_KEY=
#OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# ── Research Providers ────────────────────────────────────────────
# GitHub: optional personal access token for higher GitHub search limits.
GITHUB_TOKEN=

# ── Timeouts ──────────────────────────────────────────────────────
REQUEST_TIMEOUT=30
